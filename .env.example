# Quraish Rahman Portfolio — Required environment variables
# Copy this file's variable names into your Vercel project's Environment Variables
# and into GitHub repo Secrets (Settings → Secrets and variables → Actions).
# DO NOT commit a .env.local file with real values.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — used by Server Actions / API routes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — Dashboard → Account Details (cloud name), API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary → Settings → Upload → Upload presets — create an Unsigned preset.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Public site URL (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://quraishrahman-portfolio.vercel.app
